<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Log In</title>
    </head>

    <body>
        <h1>Log In</h1>
        <form method="post" action="/api/auth/login">
            <div>
                <label for="email">Email</label><br>
            <input 
                type="email"
                id="email" 
                name="email" 
                required>
                </div>
                <br>
                <div>
                <label for="password">Password</label><br>
            <input 
                type="password"
                id="password" 
                name="password" 
                required>
                </div>
                <br>
<button type="submit">Log In</button>
        </form>
    </body>
</html>